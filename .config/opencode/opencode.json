{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "ollama": {
            "name": "ollama",
            "npm": "@ai-sdk/openai-compatible",
            "env": [],
            "models": {
                "llama3:latest": {
                    "name": "Llama3",
                    "tool_call": true,
                    "limit": { "context": 8192, "output": 2048 }
